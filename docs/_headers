# Cloudflare Workers Static Assets custom headers.
# Long-cache the immutable asset images and download zips; HTML/sitemap/robots
# are left to Cloudflare's default revalidation so content changes (e.g. a new
# release) are picked up quickly.

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

# The checksum manifest must revalidate quickly: the in-app fail-closed updater
# fetches it to verify a download, so a freshly published hash must not be hidden
# behind the long download cache (a stale manifest would make a valid update abort).
/downloads/SHA256SUMS.txt
  Cache-Control: public, max-age=300, must-revalidate

/downloads/*
  Cache-Control: public, max-age=86400
